# Copy to .env and fill locally. Do not commit .env.

# Email ingestion (IMAP, read-only)
# Used by execution/email_alert_ingest.py. These are inherited from the parent
# DOE AI Agent .env when not set locally, so usually you do not need to copy
# them here. Generate the app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Reserved for a future OAuth-based path. The current ingester uses the app
# password above, not OAuth, so these can stay empty.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Portal APIs
# Not needed for public Flatfox listing sync. Reserve for later authenticated workflows.
FLATFOX_API_KEY=

# Tracker
# Defaults read parent DOE AI Agent credentials and keep the writable token local.
GOOGLE_SHEET_NAME="Swiss Appartment Search Pipeline"
GOOGLE_CREDENTIALS_PATH=../credentials.json
# If token.json is missing here, ../token.json is used as a read-only seed.
GOOGLE_TOKEN_PATH=token.json
# Optional override for the parent seed token.
GOOGLE_PARENT_TOKEN_PATH=../token.json
# Optional legacy service-account fallback. Requires GOOGLE_SHEET_ID.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEET_ID=

# Optional paid qualitative scoring (advisory only — never overrides decisions).
# Used by execution/llm_rerank.py. Dry-run by default; --send writes scores.
OPENROUTER_API_KEY=
# Re-rank model override. MODEL_RERANK wins, then OPENROUTER_MODEL, else the
# built-in default (google/gemma-4-31b).
MODEL_RERANK=
OPENROUTER_MODEL=

# Commute scoring
# Two live paths feed the commute score; the pipeline takes the faster of the
# two (min) and falls back to the static city→minutes table in
# apartment_pipeline.py when both are unavailable — scoring always works.
#
# 1. E-bike — OpenRouteService (https://openrouteservice.org/dev/#/signup),
#    2,000 requests/day free. Used by execution/commute_scoring.py. When unset,
#    the e-bike leg is skipped (transit + static table still score the listing).
OPENROUTESERVICE_API_KEY=
#
# 2. Public transport (oeV) — transport.opendata.ch needs NO API key and is ON
#    by default (execution/transit_scoring.py). Set TRANSPORT_OPENDATA_ENABLED=0
#    to force the static fallback (the test suite sets this to stay offline).
TRANSPORT_OPENDATA_ENABLED=1

# Search target
WORK_ADDRESS="Platz 4, 6039 Root D4, Switzerland"
